<?php
/**
 * Keepsake configuration.
 *
 * Copy this file to `config.php` (same directory) and fill in real values.
 * `config.php` is gitignored — never commit it. This example file is the
 * only config file that should ever be committed.
 *
 * All values below are placeholders.
 */

declare(strict_types=1);

return [
    // General app settings.
    'app' => [
        'name' => 'Keepsake',

        // 'local' enables PHP error display; 'production' hides it.
        'env' => 'local',

        // Used to build absolute links (not required for relative-link
        // routing today, but Phase 7's PDF export and any future emailed
        // links will want it).
        'base_url' => 'http://localhost:8000',

        // PHP session cookie name. Namespaced so it doesn't collide with
        // other apps in the suite if ever run on the same domain/port.
        'session_name' => 'keepsake_session',
    ],

    // MySQL connection. See PLAN.md "Architecture decisions" for why PDO.
    'db' => [
        'host' => '127.0.0.1',
        'port' => 3306,
        'database' => 'keepsake',
        'username' => 'keepsake_user',
        'password' => 'change-me',
        'charset' => 'utf8mb4',
    ],
];
